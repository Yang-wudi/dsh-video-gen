{
  "name": "dsh-video-gen",
  "version": "0.2.3",
  "description": "Bring text-to-video and image-to-video generation to DeepSeek Harness — DashScope Wanx, Volcengine/Doubao Seedance, Google Veo, OpenAI Sora & compatible relays.",
  "type": "module",
  "author": "Yang-wudi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yang-wudi/dsh-video-gen.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/Yang-wudi/dsh-video-gen#readme",
  "bugs": {
    "url": "https://github.com/Yang-wudi/dsh-video-gen/issues"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shared.js",
    "lib/google.js",
    "lib/reference-image.js",
    "src/index.ts",
    "src/shared.ts",
    "src/google.ts",
    "src/reference-image.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "sora",
    "seedance",
    "wanx",
    "veo",
    "gemini",
    "dashscope",
    "volcengine",
    "google",
    "doubao",
    "byok",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/shared.js && node --check lib/google.js && node --check lib/reference-image.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node tests/video-route.test.mjs && node tests/finish-video.test.mjs && node tests/reference-image.test.mjs && node tests/client-bundle.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "typescript": "^5.9.3"
  }
}
